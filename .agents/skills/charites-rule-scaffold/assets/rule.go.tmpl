// Analyze inspects the Leaf IR root node and returns diagnostics for violations.
func (r *{{STRUCT_NAME}}) Analyze(file *ir.File) []ir.Diagnostic {
	var diagnostics []ir.Diagnostic

	for node := range ir.Walk(file.Root) {
		// Rule inspection logic here
		if r.isViolation(node) {
			diagnostics = append(diagnostics, ir.Diagnostic{
				RuleID:   r.ID(),
				Severity: r.severity,
				Message:  fmt.Sprintf("{{RULE_ID}}: violation detected at %s", node.Name),
				File:     file.Path,
				Line:     node.Span.StartLine,
				Column:   node.Span.StartCol,
				EndLine:  node.Span.EndLine,
				EndCol:   node.Span.EndCol,
			})
		}
	}

	return diagnostics
}

