---
// A1: SVG clip paths, url references, and transparent values that must not be flagged
---
<svg viewBox="0 0 100 100">
  <defs>
    <linearGradient id="gradRef" />
  </defs>
  <rect width="100" height="100" fill="url(#gradRef)" />
  <circle cx="50" cy="50" r="30" fill="transparent" stroke="transparent" />
</svg>
