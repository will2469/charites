---
// Compliant: standard autocomplete attributes declared for password and email
---
<form class="space-y-4">
  <input
    type="email"
    name="email"
    autocomplete="email"
    placeholder="name@example.com"
    class="border rounded px-3 py-2"
  />
  <input
    type="password"
    name="password"
    autocomplete="current-password"
    placeholder="Password"
    class="border rounded px-3 py-2"
  />
</form>
