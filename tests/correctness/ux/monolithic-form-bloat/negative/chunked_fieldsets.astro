---
// Compliant: 8 total fields split cleanly into 2 fieldsets (4 fields each <= 7)
---
<form class="space-y-6 max-w-lg">
  <fieldset class="space-y-4 border p-4 rounded-lg">
    <legend class="font-semibold">Informasi Dasar</legend>
    <input name="nama" placeholder="Nama" />
    <input name="email" placeholder="Email" />
    <input name="telepon" placeholder="Nomor Telepon" />
    <input name="instansi" placeholder="Instansi" />
  </fieldset>

  <fieldset class="space-y-4 border p-4 rounded-lg">
    <legend class="font-semibold">Alamat Kantor</legend>
    <input name="jalan" placeholder="Jalan" />
    <input name="kota" placeholder="Kota" />
    <input name="provinsi" placeholder="Provinsi" />
    <input name="kodepos" placeholder="Kode Pos" />
  </fieldset>

  <button type="submit">Kirim Data</button>
</form>
