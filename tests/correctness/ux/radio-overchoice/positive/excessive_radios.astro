---
// Form containing 9 flat unsearchable radio buttons sharing name="province"
---
<form class="space-y-4">
  <fieldset class="space-y-2">
    <legend class="font-semibold">Pilih Provinsi</legend>
    <label><input type="radio" name="province" value="1" /> Aceh</label>
    <label><input type="radio" name="province" value="2" /> Sumut</label>
    <label><input type="radio" name="province" value="3" /> Sumbar</label>
    <label><input type="radio" name="province" value="4" /> Riau</label>
    <label><input type="radio" name="province" value="5" /> Jambi</label>
    <label><input type="radio" name="province" value="6" /> Sumsel</label>
    <label><input type="radio" name="province" value="7" /> Bengkulu</label>
    <label><input type="radio" name="province" value="8" /> Lampung</label>
    <label><input type="radio" name="province" value="9" /> Jakarta</label>
  </fieldset>
</form>
