---
// Adversarial fixture: 8 radio options accompanied by a dynamic search filter input
---
<div class="space-y-4 p-4">
  <label class="text-sm font-semibold">Cari & Pilih Wilayah</label>
  <input type="search" placeholder="Cari nama provinsi..." class="border rounded px-3 py-2 w-full" />
  <div class="radio-list space-y-1">
    <label><input type="radio" name="searchable_prov" value="1" /> Aceh</label>
    <label><input type="radio" name="searchable_prov" value="2" /> Bali</label>
    <label><input type="radio" name="searchable_prov" value="3" /> Banten</label>
    <label><input type="radio" name="searchable_prov" value="4" /> Bengkulu</label>
    <label><input type="radio" name="searchable_prov" value="5" /> Gorontalo</label>
    <label><input type="radio" name="searchable_prov" value="6" /> Jakarta</label>
    <label><input type="radio" name="searchable_prov" value="7" /> Jambi</label>
    <label><input type="radio" name="searchable_prov" value="8" /> Jabar</label>
  </div>
</div>
