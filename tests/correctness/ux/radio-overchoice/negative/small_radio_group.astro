// Compliant: small radio group with only 3 options (<= 4 passes cleanly)
---
<form class="space-y-4">
  <fieldset class="space-y-2">
    <legend class="font-semibold">Frekuensi Notifikasi</legend>
    <label><input type="radio" name="frequency" value="instant" /> Langsung</label>
    <label><input type="radio" name="frequency" value="daily" /> Harian</label>
    <label><input type="radio" name="frequency" value="weekly" /> Mingguan</label>
  </fieldset>
</form>
