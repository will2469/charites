---
// Positive fixture for inp.hydration-heavy-island: monolithic island wrapping massive static content
import ArticleViewerIsland from '../components/ArticleViewerIsland.tsx';
---
<main>
  <ArticleViewerIsland client:load>
    <header>
      <h1>Comprehensive Analysis of Modern Web Standards</h1>
    </header>
    <article>
      <p>Section 1 introduction and detailed background text...</p>
      <p>Section 2 architectural review and evaluation notes...</p>
      <p>Section 3 benchmark numbers and performance metrics...</p>
      <p>Section 4 concluding recommendations and summary...</p>
    </article>
    <footer>
      <span>Published in 2026</span>
    </footer>
  </ArticleViewerIsland>
</main>
