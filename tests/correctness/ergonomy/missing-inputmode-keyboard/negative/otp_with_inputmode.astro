---
// Astro Component with compliant OTP input
---

<div class="p-4 space-y-3">
  <label for="otp_input">Kode Verifikasi OTP</label>
  <input
    id="otp_input"
    name="otp"
    type="text"
    inputmode="numeric"
    pattern="[0-9]*"
    placeholder="123456"
    class="h-11 px-3.5 py-2.5 bg-background border border-input rounded-xl text-base"
  />
</div>
