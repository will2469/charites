---
// Adversarial fixture: Header with hamburger menu toggle and search icon button
---
<div class="min-h-screen bg-background text-foreground">
  <header class="fixed top-0 inset-x-0 z-20 flex items-center justify-between p-4 bg-card border-b">
    <a href="/" class="font-bold text-xl text-primary">Charites Desa</a>
    <div class="flex items-center gap-2">
      <button type="button" aria-label="Cari arsip surat" class="p-2 text-muted-foreground">
        <span>Search</span>
      </button>
      <button type="button" aria-label="Buka menu navigasi" class="p-2 text-foreground">
        <span>Menu</span>
      </button>
    </div>
  </header>
  <main class="p-4 mt-20">
    <p>Daftar pengumuman desa terbaru</p>
  </main>
</div>
